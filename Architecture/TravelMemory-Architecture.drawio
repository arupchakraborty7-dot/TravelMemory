<mxfile host="app.diagrams.net"><diagram name="TravelMemory Architecture" id="tm-arch"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1900" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="aws" value="AWS Cloud  |  Region us-east-1 (N. Virginia)  |  VPC vpc-0ff67eb6f5f21c89d" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#248814;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#248814;container=0;" vertex="1" parent="1"><mxGeometry x="470" y="40" width="1050" height="650" as="geometry"/></mxCell><mxCell id="aza" value="AZ us-east-1a  (subnet-0f70bba145898c4fd)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8FD;strokeColor=#147EBA;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=240;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#147EBA;container=0;" vertex="1" parent="1"><mxGeometry x="490" y="110" width="1010" height="250" as="geometry"/></mxCell><mxCell id="azb" value="AZ us-east-1b  (subnet-073e4d7f6c0efa0e5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2F8FD;strokeColor=#147EBA;dashed=1;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=240;spacingTop=4;fontStyle=1;fontSize=12;fontColor=#147EBA;container=0;" vertex="1" parent="1"><mxGeometry x="490" y="420" width="1010" height="250" as="geometry"/></mxCell><mxCell id="title" value="&lt;b&gt;TravelMemory - Deployment Architecture (AWS EC2, ALB, MongoDB Atlas, Cloudflare)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="8" width="1500" height="30" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;User / Visitor&lt;br&gt;HTTP" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;fontColor=#111827;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="335" width="130" height="90" as="geometry"/></mxCell><mxCell id="cf" value="&lt;b&gt;Cloudflare DNS&lt;/b&gt;&lt;br&gt;travelmemory.devopsarup.store&lt;br&gt;CNAME -&amp;gt; Frontend ALB" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFF1E6;strokeColor=#F38020;fontColor=#7C2D12;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230" y="335" width="180" height="90" as="geometry"/></mxCell><mxCell id="falb" value="&lt;b&gt;Frontend ALB&lt;/b&gt;&lt;br&gt;travelmemory-frontend-alb&lt;br&gt;Application, internet-facing&lt;br&gt;Listener HTTP:80&lt;br&gt;Target group:&lt;br&gt;travelmemory-frontend-tg&lt;br&gt;2/2 healthy" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#8C4FFF;fontColor=#3B1D80;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510" y="300" width="190" height="160" as="geometry"/></mxCell><mxCell id="fe1" value="&lt;b&gt;frontend-master&lt;/b&gt;&lt;br&gt;EC2 t3.small | us-east-1a&lt;br&gt;Nginx :80 (React build)&lt;br&gt;i-0fb8a603b1b98d39b&lt;br&gt;SG: frontend-sg" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEBD9;strokeColor=#ED7100;fontColor=#7C2D12;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="160" width="200" height="150" as="geometry"/></mxCell><mxCell id="fe2" value="&lt;b&gt;frontend-2&lt;/b&gt;&lt;br&gt;EC2 t3.small | us-east-1b&lt;br&gt;Nginx :80 (React build)&lt;br&gt;i-0c2eb70bd1ed4eec6&lt;br&gt;Launched from frontend AMI&lt;br&gt;SG: frontend-sg" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEBD9;strokeColor=#ED7100;fontColor=#7C2D12;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="780" y="470" width="200" height="150" as="geometry"/></mxCell><mxCell id="balb" value="&lt;b&gt;Backend ALB&lt;/b&gt;&lt;br&gt;travelmemory-backend-alb&lt;br&gt;Application, internet-facing&lt;br&gt;Listener HTTP:80&lt;br&gt;Target group:&lt;br&gt;travelmemory-backend-tg&lt;br&gt;2/2 healthy" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EDE7F6;strokeColor=#8C4FFF;fontColor=#3B1D80;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1040" y="300" width="190" height="160" as="geometry"/></mxCell><mxCell id="be1" value="&lt;b&gt;backend-master&lt;/b&gt;&lt;br&gt;EC2 t2.micro | us-east-1a&lt;br&gt;Nginx :80 -&amp;gt; Node.js :3000&lt;br&gt;(systemd service)&lt;br&gt;i-086deea32d7b185ed&lt;br&gt;SG: backend-sg" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEBD9;strokeColor=#ED7100;fontColor=#7C2D12;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1290" y="160" width="190" height="150" as="geometry"/></mxCell><mxCell id="be2" value="&lt;b&gt;backend-2&lt;/b&gt;&lt;br&gt;EC2 t2.micro | us-east-1b&lt;br&gt;Nginx :80 -&amp;gt; Node.js :3000&lt;br&gt;(systemd service)&lt;br&gt;i-0d4903d2a18129c1b&lt;br&gt;Launched from backend AMI&lt;br&gt;SG: backend-sg" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FDEBD9;strokeColor=#ED7100;fontColor=#7C2D12;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1290" y="470" width="190" height="150" as="geometry"/></mxCell><mxCell id="atlas" value="&lt;b&gt;MongoDB Atlas&lt;/b&gt;&lt;br&gt;Cluster (free tier)&lt;br&gt;Database: travelmemory&lt;br&gt;mongodb+srv (TLS)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#13AA52;fontColor=#14532D;strokeWidth=2;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1620" y="315" width="200" height="130" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;Security groups (least privilege)&lt;/b&gt;&lt;br&gt;- ALB SG (arhv-ALB-SG): HTTP 80 from the internet&lt;br&gt;- frontend-sg: HTTP 80 from ALB SG only&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; SSH 22 from admin IP /32 only&lt;br&gt;- backend-sg: HTTP 80 from ALB SG only&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; SSH 22 and TCP 3000-3001 from admin IP /32 only&lt;br&gt;- EC2 instances are not exposed directly to the internet on port 80" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="20" y="790" width="560" height="165" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;Load balancers and target groups (HTTP:80)&lt;/b&gt;&lt;br&gt;Frontend ALB -&amp;gt; travelmemory-frontend-tg (2/2 healthy)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; travelmemory-frontend-alb-1000095298.us-east-1.elb.amazonaws.com&lt;br&gt;Backend ALB -&amp;gt; travelmemory-backend-tg (2/2 healthy)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp; travelmemory-backend-alb-2063493088.us-east-1.elb.amazonaws.com&lt;br&gt;Both ALBs span subnets in us-east-1a and us-east-1b (2 AZs)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="600" y="790" width="620" height="165" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;AMI-based scaling&lt;/b&gt;&lt;br&gt;- travelmemory-frontend-ami&amp;nbsp;&amp;nbsp; ami-089a81a33922937ce&lt;br&gt;- travelmemory-backend-ami&amp;nbsp;&amp;nbsp; ami-04bd731836bddfc53&lt;br&gt;Master instances (us-east-1a) imaged once, then cloned&lt;br&gt;into us-east-1b as frontend-2 and backend-2.&lt;br&gt;Node.js runs under systemd, so clones start automatically.&lt;br&gt;Frontend is static React build served by Nginx." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontColor=#111827;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1240" y="790" width="580" height="165" as="geometry"/></mxCell><mxCell id="c11" value="HTTP" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="cf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="CNAME" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cf" target="falb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="falb" target="fe1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="falb" target="fe2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="balb" target="be1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="balb" target="be2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="mongodb+srv (TLS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#13AA52;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="be1" target="atlas"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#13AA52;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="be2" target="atlas"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c19" value="REST API calls from the browser (baseUrl = Backend ALB DNS)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#7C3AED;fontSize=11;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="browser" target="balb"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="85" y="730"/><mxPoint x="1135" y="730"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>